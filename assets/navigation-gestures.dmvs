; Native touch bindings. HTML converter compiles clicks, this layer adds
; captured contacts and two-finger gestures using dmview's standard input API.
.var $navg_car_x, int, 176
.var $navg_car_y, int, 160
.var $navg_dx, int, 0
.var $navg_dy, int, 0
.var $navg_x, int, 0
.var $navg_y, int, 0
.var $navg_cx, int, 190
.var $navg_cy, int, 178

navg_press:
        RET
navg_manual:
        SET $navRunning, 0
        SET $nav_pause_text, "Wznów"
        SET $nav_status_text, "Przegląd mapy"
        SET $nav_map_near_x_on, 0
        SET $nav_map_near_y_on, 0
        SET $nav_map_wide_x_on, 0
        SET $nav_map_wide_y_on, 0
        RET
navg_drag:
        JGT $box.contacts, 1, .done
        CALL navg_manual
        SET $navg_dx, $ev.dx
        SET $navg_dy, $ev.dy
        CALL navg_move
.done:
        RET
; Clamp the active map to the viewport. Move both projections and the car
; by exactly the applied delta; the inactive projection is rebuilt on zoom.
navg_move:
        JEQ $nav_map_near_alpha, 0, .wide
        SET $navg_x, $nav_map_near_x
        ADD $navg_x, $navg_dx
        CLAMP $navg_x, -270, 0
        SUB $navg_x, $nav_map_near_x
        SET $navg_y, $nav_map_near_y
        ADD $navg_y, $navg_dy
        CLAMP $navg_y, -392, 0
        SUB $navg_y, $nav_map_near_y
        JMP .apply
.wide:
        SET $navg_x, $nav_map_wide_x
        ADD $navg_x, $navg_dx
        CLAMP $navg_x, -130, 0
        SUB $navg_x, $nav_map_wide_x
        SET $navg_y, $nav_map_wide_y
        ADD $navg_y, $navg_dy
        CLAMP $navg_y, -264, 0
        SUB $navg_y, $nav_map_wide_y
.apply:
        ADD $nav_map_near_x, $navg_x
        ADD $nav_map_near_y, $navg_y
        ADD $nav_map_wide_x, $navg_x
        ADD $nav_map_wide_y, $navg_y
        ADD $navg_car_x, $navg_x
        ADD $navg_car_y, $navg_y
        RET
navg_zoom_in:
        SET $navg_cx, 190
        SET $navg_cy, 178
        CALL navg_near
        RET
navg_zoom_out:
        SET $navg_cx, 190
        SET $navg_cy, 178
        CALL navg_wide
        RET
navg_near:
        JNE $nav_map_near_alpha, 0, .done
        CALL navg_manual
        SET $nav_map_near_x, $nav_map_wide_x
        SUB $nav_map_near_x, $navg_cx
        MUL $nav_map_near_x, 5
        DIV $nav_map_near_x, 4
        ADD $nav_map_near_x, $navg_cx
        SET $nav_map_near_y, $nav_map_wide_y
        SUB $nav_map_near_y, $navg_cy
        MUL $nav_map_near_y, 5
        DIV $nav_map_near_y, 4
        ADD $nav_map_near_y, $navg_cy
        SET $nav_map_near_alpha, 255
        SET $nav_map_wide_alpha, 0
        CALL navg_scale_car_up
        CALL navg_clamp
.done:
        RET
navg_wide:
        JEQ $nav_map_near_alpha, 0, .done
        CALL navg_manual
        SET $nav_map_wide_x, $nav_map_near_x
        SUB $nav_map_wide_x, $navg_cx
        MUL $nav_map_wide_x, 4
        DIV $nav_map_wide_x, 5
        ADD $nav_map_wide_x, $navg_cx
        SET $nav_map_wide_y, $nav_map_near_y
        SUB $nav_map_wide_y, $navg_cy
        MUL $nav_map_wide_y, 4
        DIV $nav_map_wide_y, 5
        ADD $nav_map_wide_y, $navg_cy
        SET $nav_map_near_alpha, 0
        SET $nav_map_wide_alpha, 255
        CALL navg_scale_car_down
        CALL navg_clamp
.done:
        RET
navg_scale_car_up:
        ADD $navg_car_x, 14
        SUB $navg_car_x, $navg_cx
        MUL $navg_car_x, 5
        DIV $navg_car_x, 4
        ADD $navg_car_x, $navg_cx
        SUB $navg_car_x, 14
        ADD $navg_car_y, 18
        SUB $navg_car_y, $navg_cy
        MUL $navg_car_y, 5
        DIV $navg_car_y, 4
        ADD $navg_car_y, $navg_cy
        SUB $navg_car_y, 18
        RET
navg_scale_car_down:
        ADD $navg_car_x, 14
        SUB $navg_car_x, $navg_cx
        MUL $navg_car_x, 4
        DIV $navg_car_x, 5
        ADD $navg_car_x, $navg_cx
        SUB $navg_car_x, 14
        ADD $navg_car_y, 18
        SUB $navg_car_y, $navg_cy
        MUL $navg_car_y, 4
        DIV $navg_car_y, 5
        ADD $navg_car_y, $navg_cy
        SUB $navg_car_y, 18
        RET
navg_clamp:
        SET $navg_dx, 0
        SET $navg_dy, 0
        CALL navg_move
        RET
navg_pinch:
        SET $navg_cx, $ev.cx
        SET $navg_cy, $ev.cy
        ADD $navg_cy, 76
        JGE $ev.scale, 1150, .in
        JGT $ev.scale, 850, .done
        CALL navg_wide
        RET
.in:
        CALL navg_near
.done:
        RET
navg_recenter:
        SET $navg_car_x, 176
        SET $navg_car_y, 160
        CALL @RECENTER_HANDLER@
        RET
navg_pause:
        CALL @PAUSE_HANDLER@
        JNE $navRunning, 1, .done
        CALL navg_recenter
.done:
        RET
